                <ANNOTATION_VALUE>люди которые говорят мне не нравится чтение это вероятнее всего люди которые просто не нашли что именно нравится им читать потому что</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a16"
                TIME_SLOT_REF1="ts19" TIME_SLOT_REF2="ts20">
